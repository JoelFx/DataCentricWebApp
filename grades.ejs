<!DOCTYPE html>
<html>
<head>
    <title>Grades</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 40px; }
        table { border-collapse: collapse; width: 100%; }
        th, td { border: 1px solid black; padding: 8px; text-align: left; }
        a { color: purple; text-decoration: none; }
    </style>
</head>
<body>
    <h1>Grades</h1>
    <a href="/">Home</a>
    
    <table>
        <tr>
            <th>Student</th>
            <th>Module</th>
            <th>Grade</th>
        </tr>
        <% 
        let currentStudent = '';
        grades.forEach(function(grade) { 
            if (grade.student_name !== currentStudent) {
                currentStudent = grade.student_name;
        %>
            <tr>
                <td><%= grade.student_name %></td>
                <td><%= grade.module_name || '' %></td>
                <td><%= grade.grade || '' %></td>
            </tr>
        <% } else { %>
            <tr>
                <td></td>
                <td><%= grade.module_name || '' %></td>
                <td><%= grade.grade || '' %></td>
            </tr>
        <% }}); %>
    </table>
</body>
</html>